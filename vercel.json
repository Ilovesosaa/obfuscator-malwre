{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "bin/luau-ast",
          "bin/luau-compile",
          "lib/control-flow.js",
          "vendor/FIU-LICENSE.txt",
          "vendor/Fiu.luau",
          "vendor/LUAU-LICENSE.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
